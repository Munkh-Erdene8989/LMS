// Supabase Postgres.
// DATABASE_URL: transaction pooler (6543, ?pgbouncer=true) — апп ажиллах үед.
// DIRECT_URL:   session pooler (5432) — migration-д.
// Тест нь `?schema=lms_test` бүхий тусдаа URL ашиглана (apps/api/test).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Платформын тохиргоо (key-value). Ticket 04 өргөтгөнө.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Нэвтрэлт (ticket 02)
// ---------------------------------------------------------------------------

enum Role {
  LEARNER
  TEACHER
  ADMIN
}

enum IdentifierType {
  PHONE
  EMAIL
}

enum OtpPurpose {
  /// Нэвтрэх / бүртгүүлэх
  LOGIN
  /// Нэвтэрсэн хэрэглэгч хоёр дахь identifier холбох
  LINK
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String?
  avatarUrl    String?  @map("avatar_url")
  roles        Role[]   @default([LEARNER])
  /// "Бүх төхөөрөмжөөс гарах" үед нэмэгдэж, хуучин access token-уудыг хүчингүй болгоно.
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  identifiers Identifier[]
  sessions    Session[]

  @@map("users")
}

/// Баталгаажсан утас эсвэл имэйл. Хэрэглэгч төрөл бүрээс нэгийг л эзэмшинэ.
model Identifier {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  type       IdentifierType
  /// Нормчилсон утга: утас `+976XXXXXXXX`, имэйл жижиг үсгээр.
  value      String         @unique
  verifiedAt DateTime       @map("verified_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("identifiers")
}

/// OTP оролдлого. Утсанд verify.mn session (хэрэглэгч кодыг 144773 руу илгээнэ), имэйлд Resend-ээр код.
model OtpChallenge {
  id                String         @id @default(uuid()) @db.Uuid
  type              IdentifierType
  value             String
  purpose           OtpPurpose
  /// LINK үед холбох хэрэглэгч
  userId            String?        @map("user_id") @db.Uuid
  codeHash          String         @map("code_hash")
  providerSessionId String?        @map("provider_session_id")
  attempts          Int            @default(0)
  ip                String?
  expiresAt         DateTime       @map("expires_at")
  consumedAt        DateTime?      @map("consumed_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([value, createdAt])
  @@index([ip, createdAt])
  @@map("otp_challenges")
}

/// Refresh token. Rotation бүрт шинэ мөр; нэг family-д дахин ашиглалт илэрвэл family бүхэлдээ хүчингүй.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  rotatedAt DateTime? @map("rotated_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}
