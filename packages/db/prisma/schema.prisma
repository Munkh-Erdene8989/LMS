// Supabase Postgres.
// DATABASE_URL: transaction pooler (6543, ?pgbouncer=true) — апп ажиллах үед.
// DIRECT_URL:   session pooler (5432) — migration-д.
// Тест нь `?schema=lms_test` бүхий тусдаа URL ашиглана (apps/api/test).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Платформын тохиргоо (key-value). Мөр байхгүй бол кодын анхдагч утга (apps/api/src/admin/settings.registry.ts).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  revisions SettingRevision[]

  @@map("settings")
}

/// Тохиргооны өөрчлөлт бүр (хувилбар).
model SettingRevision {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  /// Өмнөх утга (анх өөрчлөхөд анхдагч утга)
  previous    Json
  value       Json
  changedById String?  @map("changed_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  setting   Setting @relation(fields: [key], references: [key], onDelete: Cascade)
  changedBy User?   @relation("SettingRevisions", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([key, createdAt(sort: Desc)])
  @@map("setting_revisions")
}

// ---------------------------------------------------------------------------
// Нэвтрэлт (ticket 02)
// ---------------------------------------------------------------------------

enum Role {
  LEARNER
  TEACHER
  ADMIN
}

enum IdentifierType {
  PHONE
  EMAIL
}

enum OtpPurpose {
  /// Нэвтрэх / бүртгүүлэх
  LOGIN
  /// Нэвтэрсэн хэрэглэгч хоёр дахь identifier холбох
  LINK
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String?
  avatarUrl    String?  @map("avatar_url")
  roles        Role[]   @default([LEARNER])
  /// "Бүх төхөөрөмжөөс гарах" үед нэмэгдэж, хуучин access token-уудыг хүчингүй болгоно.
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  identifiers   Identifier[]
  sessions      Session[]
  notifications Notification[]

  settingRevisions SettingRevision[] @relation("SettingRevisions")
  auditLogs        AuditLog[]        @relation("AuditActor")
  legalDocuments   LegalDocument[]   @relation("LegalAuthor")
  legalAcceptances LegalAcceptance[]

  teacherApplication   TeacherApplication?
  reviewedApplications TeacherApplication[] @relation("ApplicationReviewer")
  bankAccount          BankAccount?

  courses         Course[]
  reviewedCourses Course[] @relation("CourseReviewer")

  payments      Payment[]
  creditLots    CreditLot[]
  creditEntries CreditLedgerEntry[]

  purchases          Purchase[]            @relation("PurchaseBuyer")
  sales              Purchase[]            @relation("PurchaseTeacher")
  referredPurchases  Purchase[]            @relation("PurchaseReferrer")
  entitlements       Entitlement[]
  courseEntitlements CourseEntitlement[]
  earningEntries     TeacherEarningEntry[] @relation("EarningTeacher")
  earningAdjustments TeacherEarningEntry[] @relation("EarningActor")
  lessonProgress     LessonProgress[]
  quizAttempts       QuizAttempt[]
  certificates       Certificate[]

  submissions       AssignmentSubmission[] @relation("SubmissionLearner")
  gradedSubmissions AssignmentSubmission[] @relation("SubmissionReviewer")

  subscription Subscription?
  paymentCard  PaymentCard?

  referralCode       ReferralCode?
  referralsAsTeacher ReferralAttribution[] @relation("ReferralTeacher")
  referralsAsLearner ReferralAttribution[] @relation("ReferralLearner")

  payouts            Payout[]     @relation("PayoutTeacher")
  processedPayouts   Payout[]     @relation("PayoutProcessor")
  payoutHold         PayoutHold?  @relation("PayoutHoldTeacher")
  payoutHoldsCreated PayoutHold[] @relation("PayoutHoldActor")

  reviews             Review[]      @relation("ReviewAuthor")
  hiddenReviews       Review[]      @relation("ReviewHider")
  reviewReplies       ReviewReply[] @relation("ReviewReplyAuthor")
  hiddenReviewReplies ReviewReply[] @relation("ReviewReplyHider")

  @@map("users")
}

/// Баталгаажсан утас эсвэл имэйл. Хэрэглэгч төрөл бүрээс нэгийг л эзэмшинэ.
model Identifier {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  type       IdentifierType
  /// Нормчилсон утга: утас `+976XXXXXXXX`, имэйл жижиг үсгээр.
  value      String         @unique
  verifiedAt DateTime       @map("verified_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("identifiers")
}

/// OTP оролдлого. Утсанд verify.mn session (хэрэглэгч кодыг 144773 руу илгээнэ), имэйлд Resend-ээр код.
model OtpChallenge {
  id                String         @id @default(uuid()) @db.Uuid
  type              IdentifierType
  value             String
  purpose           OtpPurpose
  /// LINK үед холбох хэрэглэгч
  userId            String?        @map("user_id") @db.Uuid
  codeHash          String         @map("code_hash")
  providerSessionId String?        @map("provider_session_id")
  attempts          Int            @default(0)
  ip                String?
  expiresAt         DateTime       @map("expires_at")
  consumedAt        DateTime?      @map("consumed_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([value, createdAt])
  @@index([ip, createdAt])
  @@map("otp_challenges")
}

/// Refresh token. Rotation бүрт шинэ мөр; нэг family-д дахин ашиглалт илэрвэл family бүхэлдээ хүчингүй.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  rotatedAt DateTime? @map("rotated_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Мэдэгдэл (ticket 03)
// ---------------------------------------------------------------------------

enum EmailStatus {
  /**
   * Хэрэглэгч имэйлгүй — зөвхөн in-app
   */
  NONE
  QUEUED
  SENT
  FAILED
}

/**
 * In-app мэдэгдэл (хонх). Текстийг уншихдаа translation-аас `type` + `params`-аар үүсгэнэ.
 */
model Notification {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  /**
   * `apps/api/src/i18n/mn.json` → `notifications.<type>`
   */
  type        String
  params      Json        @default("{}")
  link        String?
  readAt      DateTime?   @map("read_at")
  emailStatus EmailStatus @default(NONE) @map("email_status")
  emailSentAt DateTime?   @map("email_sent_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Админ (ticket 04)
// ---------------------------------------------------------------------------

/// Админы (болон системийн) үйлдэл бүр. Зөвхөн нэмэгдэнэ, засагдахгүй.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// null = систем (CLI, cron)
  actorId    String?  @map("actor_id") @db.Uuid
  /// жишээ: `setting.update`, `legal.publish`, `user.role.grant`
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

enum LegalDocType {
  TERMS
  PRIVACY
  TEACHER_AGREEMENT
}

/// Хууль эрх зүйн баримтын хувилбар. `publishedAt` null = ноорог (засаж болно); нийтэлсэн нь өөрчлөгдөхгүй.
model LegalDocument {
  id          String       @id @default(uuid()) @db.Uuid
  type        LegalDocType
  version     Int
  title       String
  body        String
  publishedAt DateTime?    @map("published_at")
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  createdBy   User?             @relation("LegalAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@index([type, publishedAt])
  @@map("legal_documents")
}

/// Хэрэглэгч тухайн хувилбарыг хэзээ зөвшөөрсөн.
model LegalAcceptance {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  ip         String?
  acceptedAt DateTime @default(now()) @map("accepted_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  teacherApplications TeacherApplication[]

  @@unique([userId, documentId])
  @@map("legal_acceptances")
}

// ---------------------------------------------------------------------------
// Багшийн өргөдөл (ticket 05)
// ---------------------------------------------------------------------------

enum TeacherApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/// Хэрэглэгч бүрт нэг өргөдөл; буцаагдвал засаж дахин илгээнэ (ижил мөр).
model TeacherApplication {
  id                    String                   @id @default(uuid()) @db.Uuid
  userId                String                   @unique @map("user_id") @db.Uuid
  status                TeacherApplicationStatus
  displayName           String                   @map("display_name")
  bio                   String
  expertise             String
  sampleUrl             String                   @map("sample_url")
  /// Илгээх үед зөвшөөрсөн багшийн гэрээний хувилбар
  agreementAcceptanceId String                   @map("agreement_acceptance_id") @db.Uuid
  submittedAt           DateTime                 @map("submitted_at")
  /// Буцаасан шалтгаан (зөвшөөрөхөд null)
  reviewNote            String?                  @map("review_note")
  reviewedById          String?                  @map("reviewed_by_id") @db.Uuid
  reviewedAt            DateTime?                @map("reviewed_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy          User?           @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  agreementAcceptance LegalAcceptance @relation(fields: [agreementAcceptanceId], references: [id], onDelete: NoAction)

  @@index([status, submittedAt])
  // Каталогийн хайлт: багшийн нийтийн нэр (ticket 07)
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "teacher_applications_display_name_trgm_idx")
  @@map("teacher_applications")
}

/// Payout-д ашиглах банкны данс. Хэрэглэгч бүрт нэг.
model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  /// `@lms/shared` → BANKS
  bank          String
  accountNumber String   @map("account_number")
  holderName    String   @map("holder_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

// ---------------------------------------------------------------------------
// Каталог: ангилал, курс, section, lesson (ticket 06)
// ---------------------------------------------------------------------------

/// 2 түвшний ангилал: parentId null = үндсэн ангилал.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  slug      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  courses  Course[]

  @@index([parentId, position])
  @@map("categories")
}

enum CourseLevel {
  ALL
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
}

model Course {
  id           String       @id @default(uuid()) @db.Uuid
  teacherId    String       @map("teacher_id") @db.Uuid
  title        String
  description  String       @default("")
  /// Storage `public` bucket дахь зураг
  coverKey     String?      @map("cover_key")
  categoryId   String?      @map("category_id") @db.Uuid
  level        CourseLevel  @default(ALL)
  /// Курсийг бүтнээр нь авах үнэ (кредит). Худалдан авалтын үед өмнө төлсөн lesson-ы кредит хасагдана.
  priceCredits Int?         @map("price_credits")
  status       CourseStatus @default(DRAFT)
  reviewNote   String?      @map("review_note")
  reviewedById String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?    @map("reviewed_at")
  submittedAt  DateTime?    @map("submitted_at")
  publishedAt  DateTime?    @map("published_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  teacher    User      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  reviewedBy User?     @relation("CourseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sections   Section[]
  lessons    Lesson[]

  purchases          Purchase[]
  entitlements       Entitlement[]
  courseEntitlements CourseEntitlement[]
  lessonProgress     LessonProgress[]
  quizAttempts       QuizAttempt[]
  certificates       Certificate[]
  reviews            Review[]

  submissions AssignmentSubmission[]

  @@index([teacherId])
  @@index([status, submittedAt])
  // Каталог (ticket 07). Trigram index-ууд migration-д `extensions.gin_trgm_ops`-оор үүссэн; энд `raw("gin_trgm_ops")` нь
  // introspection-тэй таарч, `migrate diff` тэднийг дахин үүсгэхгүй байхад л хэрэгтэй (20261117600000_catalog_search).
  @@index([status, publishedAt(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "courses_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "courses_description_trgm_idx")
  @@map("courses")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
  @@map("sections")
}

/// Lesson-ы төрөл. Төрөл бүрийн `content`-ийн хэлбэр: apps/api/src/catalog/lesson-types.ts
enum LessonType {
  VIDEO
  TEXT
  PDF
  QUIZ
  ASSIGNMENT
  LIVE
}

/// Lesson бүрийн шалгалтын төлөв. Нийтлэгдсэн курсэд шинэ lesson тусдаа шалгагдана;
/// APPROVED lesson дахин шалгалтад орохгүй тул худалдан авсан хэрэглэгчийн эрх алдагдахгүй.
enum LessonReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model Lesson {
  id            String             @id @default(uuid()) @db.Uuid
  courseId      String             @map("course_id") @db.Uuid
  sectionId     String             @map("section_id") @db.Uuid
  title         String
  type          LessonType
  position      Int
  priceCredits  Int                @default(0) @map("price_credits")
  isFreePreview Boolean            @default(false) @map("is_free_preview")
  /// Төрлөөс хамаарах контент (text: markdown; pdf: storage key, нэр, хэмжээ)
  content       Json               @default("{}")
  reviewStatus  LessonReviewStatus @default(DRAFT) @map("review_status")
  reviewNote    String?            @map("review_note")
  approvedAt    DateTime?          @map("approved_at")
  /// Нийтлэгдсэн lesson-ыг устгахын оронд архивлана (худалдан авсан хүмүүст хэвээр).
  archivedAt    DateTime?          @map("archived_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  purchases     Purchase[]
  entitlements  Entitlement[]
  progress      LessonProgress[]
  quizAttempts  QuizAttempt[]
  liveReminders LiveReminder[]
  videos        LessonVideo[]

  submissions AssignmentSubmission[]

  @@index([courseId, reviewStatus])
  @@index([sectionId, position])
  @@map("lessons")
}

/// Live хичээлийн сануулгын төрөл (ticket 14): эхлэхээс 24 цаг / 15 минутын өмнө.
enum LiveReminderKind {
  H24
  M15
}

/// Илгээсэн live сануулга (ticket 14). (lesson, төрөл, эхлэх цаг) тус бүр нэг л удаа: дарааллын ажил
/// энэ мөрийг "claim" хийж байж мэдэгдэл илгээнэ. Цаг өөрчлөгдвөл `starts_at` өөр тул шинэ сануулга очно.
/// Live-ийн цаг, үргэлжлэх хугацаа, линк нь `lessons.content`-д (apps/api/src/catalog/lesson-types.ts).
model LiveReminder {
  lessonId String           @map("lesson_id") @db.Uuid
  kind     LiveReminderKind
  startsAt DateTime         @map("starts_at")
  sentAt   DateTime         @default(now()) @map("sent_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, kind, startsAt])
  @@map("live_reminders")
}

// ---------------------------------------------------------------------------
// Видео (ticket 10, Mux)
// ---------------------------------------------------------------------------

enum VideoStatus {
  /// Direct upload URL үүсгэсэн, файл ирээгүй
  UPLOADING
  /// Файл ирж asset үүссэн, Mux боловсруулж байна
  PROCESSING
  READY
  ERRORED
}

/// Mux-д оруулсан видео. Багш файлаа солих бүрт шинэ мөр; lesson-ы идэвхтэй видео нь
/// `lessons.content.videoId` (төлөв, үргэлжлэх хугацааг content-д давхар хадгална — apps/api/src/media).
/// `id` = Mux-ийн `passthrough` — webhook-ийн дараалал холилдсон ч мөрөө олно.
model LessonVideo {
  id              String      @id @default(uuid()) @db.Uuid
  lessonId        String      @map("lesson_id") @db.Uuid
  muxUploadId     String      @unique @map("mux_upload_id")
  muxAssetId      String?     @unique @map("mux_asset_id")
  /// Signed playback policy-той playback id
  playbackId      String?     @map("playback_id")
  status          VideoStatus @default(UPLOADING)
  durationSeconds Float?      @map("duration_seconds")
  error           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_videos")
}

/// Хүлээн авсан Mux webhook (гарын үсэг шалгасны дараа). Mux-ийн event id-аар давхардалгүй;
/// BullMQ-ийн `mux.webhook` ажил боловсруулаад `processed_at` тавина.
model MuxWebhookEvent {
  id          String    @id
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@map("mux_webhook_events")
}

// ---------------------------------------------------------------------------
// Кредит ба төлбөр (ticket 08)
// Балансыг зөвхөн apps/api/src/credits/credits.service.ts өөрчилнө.
// ---------------------------------------------------------------------------

/// Админаас тохируулдаг цэнэглэх багц. `isTest` = зөвхөн админд харагдах туршилтын (100₮) багц.
model CreditPackage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  credits   Int
  priceMnt  Int      @map("price_mnt")
  active    Boolean  @default(true)
  isTest    Boolean  @default(false) @map("is_test")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments Payment[]

  @@index([active, position])
  @@map("credit_packages")
}

enum PaymentStatus {
  /// Нэхэмжлэх үүссэн, төлөгдөөгүй
  PENDING
  /// QPay payment check-ээр баталгаажиж, кредит олгогдсон
  PAID
  /// Төлсөн дүн нэхэмжлэхтэй таарахгүй — кредит олгоогүй, админ шалгана
  AMOUNT_MISMATCH
  /// Нэхэмжлэх үүсгэж чадаагүй (эсвэл картын төлбөр татгалзсан)
  FAILED
  /// Цуцалсан нэхэмжлэх — төлөх шаардлагагүй болсон (subscription цуцлах/зогсоох, ticket 17)
  CANCELED
}

enum PaymentPurpose {
  CREDIT_TOPUP
  /// Сарын багцын төлбөр (ticket 17)
  SUBSCRIPTION
}

/// QPay төлбөр. Худалдан авах үеийн дүн, кредит, кредитийн ₮ үнийг хадгална.
model Payment {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  purpose           PaymentPurpose @default(CREDIT_TOPUP)
  packageId         String?        @map("package_id") @db.Uuid
  status            PaymentStatus  @default(PENDING)
  amountMnt         Int            @map("amount_mnt")
  credits           Int
  /// Тухайн үеийн `creditPriceMnt` тохиргоо (тайланд)
  creditPriceMnt    Int            @map("credit_price_mnt")
  isTest            Boolean        @default(false) @map("is_test")
  /// Callback URL-д орох таамаглашгүй токен
  callbackToken     String         @unique @map("callback_token")
  providerInvoiceId String?        @unique @map("provider_invoice_id")
  providerPaymentId String?        @map("provider_payment_id")
  qrText            String?        @map("qr_text") @db.Text
  qrImage           String?        @map("qr_image") @db.Text
  shortUrl          String?        @map("short_url") @db.Text
  /// QPay `urls[]` — банкны апп-ын deeplink-үүд
  deeplinks         Json           @default("[]")
  /// QPay-ээс төлөгдсөн гэж ирсэн дүн (таарахгүй үед шалгахад)
  paidAmountMnt     Int?           @map("paid_amount_mnt")
  paidAt            DateTime?      @map("paid_at")
  lastCheckedAt     DateTime?      @map("last_checked_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // --- Subscription (ticket 17) ---
  subscriptionId String?       @map("subscription_id") @db.Uuid
  planId         String?       @map("plan_id") @db.Uuid
  /// Сунгалтын төлбөр бол аль үеийн төгсгөлийг (`current_period_end`) сунгаж буй нь. Эхлэх/дахин идэвхжүүлэхэд null.
  renewalFor     DateTime?     @map("renewal_for")
  method         PaymentMethod @default(INVOICE)
  failureReason  String?       @map("failure_reason")

  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  package CreditPackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  lot     CreditLot?

  subscription Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan?   @relation(fields: [planId], references: [id], onDelete: Restrict)
  period       SubscriptionPeriod?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([subscriptionId, status])
  @@map("payments")
}

enum CreditEntryType {
  TOPUP
  SUBSCRIPTION_GRANT
  SPEND
  EXPIRE
  ADMIN_ADJUST
}

/// Нэг удаагийн кредит орлого. `remaining` нь зөвхөн CreditsService-ээр (хэрэглэгчийн мөрийг түгжиж) өөрчлөгдөнө.
model CreditLot {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  /// TOPUP | SUBSCRIPTION_GRANT | ADMIN_ADJUST
  source         CreditEntryType
  initial        Int
  remaining      Int
  expiresAt      DateTime        @map("expires_at")
  /// EXPIRE бичилт хийгдсэн огноо (давхар дуусгахгүй)
  expiredAt      DateTime?       @map("expired_at")
  /// Дуусахаас 30 / 7 хоногийн өмнөх сануулга илгээсэн огноо (ticket 16 — lot бүрт нэг л удаа)
  remind30SentAt DateTime?       @map("remind_30_sent_at")
  remind7SentAt  DateTime?       @map("remind_7_sent_at")
  paymentId      String?         @unique @map("payment_id") @db.Uuid
  isTest         Boolean         @default(false) @map("is_test")
  createdAt      DateTime        @default(now()) @map("created_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment     Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  allocations CreditAllocation[]

  @@index([userId, expiresAt])
  @@index([expiresAt, remaining])
  @@map("credit_lots")
}

/// Append-only ledger. `amount` тэмдэгтэй: орлого +, зарлага −. Засагдахгүй, устгагдахгүй.
model CreditLedgerEntry {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  type      CreditEntryType
  amount    Int
  /// Тест төлбөрөөс (эсвэл тест lot-оос) үүссэн — тайланд тусад нь
  isTest    Boolean         @default(false) @map("is_test")
  /// Админ засварын шалтгаан г.м
  reason    String?
  /// ADMIN_ADJUST хийсэн админ
  actorId   String?         @map("actor_id") @db.Uuid
  /// Зарцуулалтын объект (жишээ нь `lesson_purchase`, id) — ticket 09
  refType   String?         @map("ref_type")
  refId     String?         @map("ref_id")
  paymentId String?         @map("payment_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  allocations CreditAllocation[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([type, createdAt])
  @@index([refType, refId])
  @@map("credit_ledger_entries")
}

/// Бичилт аль lot-ыг хэдээр өөрчилсөн (FIFO зарцуулалт олон lot хамардаг).
model CreditAllocation {
  id      String @id @default(uuid()) @db.Uuid
  entryId String @map("entry_id") @db.Uuid
  lotId   String @map("lot_id") @db.Uuid
  /// Тэмдэгтэй: grant +, spend/expire −
  amount  Int

  entry CreditLedgerEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  lot   CreditLot         @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([lotId])
  @@map("credit_allocations")
}

// ---------------------------------------------------------------------------
// Subscription (ticket 17)
// ---------------------------------------------------------------------------

enum PaymentMethod {
  /// QPay нэхэмжлэх (QR / банкны deeplink)
  INVOICE
  /// Холбосон картын токеноор
  CARD
}

/// Админаас тохируулдаг сарын багц.
model SubscriptionPlan {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  priceMnt  Int      @map("price_mnt")
  /// Сар бүр олгох кредит
  credits   Int
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  payments      Payment[]

  @@index([active, position])
  @@map("subscription_plans")
}

/// INCOMPLETE → ACTIVE → PAST_DUE (3 хоног) → PAUSED; CANCELED. Шилжилтүүд: apps/api/src/subscriptions/state.ts
enum SubscriptionStatus {
  /// Анхны төлбөр хүлээгдэж байна
  INCOMPLETE
  ACTIVE
  /// Сунгалтын төлбөр ороогүй (нэхэмжлэх илгээсэн)
  PAST_DUE
  /// 3 хоног төлөөгүй — сунгалт зогссон, дахин идэвхжүүлэх хүртэл
  PAUSED
  /// Хэрэглэгч цуцалсан — дахин сунгагдахгүй
  CANCELED
}

/// Хэрэглэгч бүрт нэг мөр (дахин идэвхжүүлэхэд ижил мөр).
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  pastDueSince       DateTime?          @map("past_due_since")
  pausedAt           DateTime?          @map("paused_at")
  canceledAt         DateTime?          @map("canceled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]
  periods  SubscriptionPeriod[]

  @@index([status, currentPeriodEnd])
  @@index([status, pastDueSince])
  @@map("subscriptions")
}

/// Төлөгдсөн үе бүр. (subscription, starts_at) болон payment нь unique → нэг үе нэг л удаа олгогдоно.
model SubscriptionPeriod {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  paymentId      String   @unique @map("payment_id") @db.Uuid
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  credits        Int
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, startsAt])
  @@map("subscription_periods")
}

enum PaymentCardStatus {
  /// QPay-ийн карт бүртгэлийн хуудас руу илгээсэн, дуусаагүй
  PENDING
  ACTIVE
}

/// Холбосон карт: зөвхөн QPay-ийн токен + маск дугаар. Картын түүхий мэдээлэл хэзээ ч хадгалахгүй.
model PaymentCard {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @unique @map("user_id") @db.Uuid
  status         PaymentCardStatus @default(PENDING)
  registrationId String            @unique @map("registration_id")
  /// QPay-ийн картын токен (API-д хэзээ ч буцаахгүй)
  token          String?
  maskedPan      String?           @map("masked_pan")
  brand          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_cards")
}

// ---------------------------------------------------------------------------
// Худалдан авалт, эрх, багшийн орлого (ticket 09)
// Бүгд apps/api/src/purchases/purchases.service.ts-ээр, кредит хасалттай НЭГ transaction-д.
// ---------------------------------------------------------------------------

enum PurchaseKind {
  LESSON
  COURSE
}

/// Худалдан авалт хэнээс эх үүсвэртэй — шимтгэлийн хувийг тодорхойлно (ticket 11 REFERRAL-ыг бөглөнө).
enum PurchaseAttribution {
  PLATFORM
  REFERRAL
}

/// Худалдан авалт бүр (append-only). Үнэ, шимтгэл, attribution худалдан авах мөчийнхөөр хадгалагдана.
model Purchase {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  courseId          String              @map("course_id") @db.Uuid
  /// LESSON үед авсан lesson; COURSE үед null
  lessonId          String?             @map("lesson_id") @db.Uuid
  /// Худалдах үеийн курсийн багш (тайланд)
  teacherId         String              @map("teacher_id") @db.Uuid
  kind              PurchaseKind
  /// Жагсаалтын үнэ (lesson-ы эсвэл курсийн бүтэн үнэ)
  listCredits       Int                 @map("list_credits")
  /// Бодит зарцуулсан кредит. COURSE: max(0, list − өмнө нь энэ курсийн lesson-д зарцуулсан)
  credits           Int
  /// Худалдах үеийн `creditPriceMnt`
  creditPriceMnt    Int                 @map("credit_price_mnt")
  /// Худалдах үеийн шимтгэл (%) — attribution-аас хамаарна
  commissionPercent Int                 @map("commission_percent")
  attribution       PurchaseAttribution @default(PLATFORM)
  /// REFERRAL үед урьсан багш (ticket 11)
  referrerId        String?             @map("referrer_id") @db.Uuid
  /// Кредитийн SPEND бичилт (credits = 0 бол null)
  creditEntryId     String?             @unique @map("credit_entry_id") @db.Uuid
  /// Тест lot-оос зарцуулсан — тайланд тусад нь
  isTest            Boolean             @default(false) @map("is_test")
  createdAt         DateTime            @default(now()) @map("created_at")

  user     User    @relation("PurchaseBuyer", fields: [userId], references: [id], onDelete: Restrict)
  teacher  User    @relation("PurchaseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  referrer User?   @relation("PurchaseReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  entitlements      Entitlement[]
  courseEntitlement CourseEntitlement?
  earningEntries    TeacherEarningEntry[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, courseId])
  @@index([teacherId, createdAt(sort: Desc)])
  @@index([lessonId])
  @@map("purchases")
}

/// Learner-ийн lesson-д нэвтрэх эрх. Нэг lesson-ыг хоёр удаа авахгүй (unique).
model Entitlement {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  purchaseId String   @map("purchase_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@index([lessonId])
  @@index([purchaseId])
  @@map("entitlements")
}

/// Курсийг бүтнээр авсан: тухайн үеийн lesson-ууд `Entitlement`-ээр, дараа нь зөвшөөрөгдөх шинэ lesson-ууд
/// энэ мөрөөр эрхтэй болно. Нэг курсийг хоёр удаа бүтнээр авахгүй (unique).
model CourseEntitlement {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  purchaseId String   @unique @map("purchase_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_entitlements")
}

enum TeacherEarningType {
  SALE_EARNING
  PAYOUT
  ADMIN_ADJUST
}

/// Багшийн орлогын append-only ledger (₮, тэмдэгтэй: орлого +, payout −). Засагдахгүй, устгагдахгүй.
model TeacherEarningEntry {
  id                String               @id @default(uuid()) @db.Uuid
  teacherId         String               @map("teacher_id") @db.Uuid
  type              TeacherEarningType
  amountMnt         Int                  @map("amount_mnt")
  /// SALE_EARNING: эх худалдан авалт
  purchaseId        String?              @map("purchase_id") @db.Uuid
  /// SALE_EARNING: тооцооны оролт (худалдах мөчийнх) — дараа тохиргоо өөрчлөгдсөн ч түүх зөв
  credits           Int?
  creditPriceMnt    Int?                 @map("credit_price_mnt")
  commissionPercent Int?                 @map("commission_percent")
  /// credits × creditPriceMnt
  grossMnt          Int?                 @map("gross_mnt")
  attribution       PurchaseAttribution?
  isTest            Boolean              @default(false) @map("is_test")
  reason            String?
  /// ADMIN_ADJUST / PAYOUT хийсэн админ
  actorId           String?              @map("actor_id") @db.Uuid
  /// PAYOUT г.м-ийн объект (ticket 20: `payout`, id)
  refType           String?              @map("ref_type")
  refId             String?              @map("ref_id")
  createdAt         DateTime             @default(now()) @map("created_at")

  teacher  User      @relation("EarningTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  actor    User?     @relation("EarningActor", fields: [actorId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// PAYOUT бичилтийн эх хүсэлт (ticket 20)
  payout   Payout?

  @@index([teacherId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([purchaseId])
  @@index([type, createdAt])
  @@index([refType, refId])
  @@map("teacher_earning_entries")
}

// ---------------------------------------------------------------------------
// Referral (ticket 11)
// ---------------------------------------------------------------------------

/// Багшийн тогтмол referral код (`/r/<code>`). Багш referral хэсгээ анх нээхэд үүснэ.
model ReferralCode {
  teacherId String   @id @map("teacher_id") @db.Uuid
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

/// Хэрэглэгч багшийн линкээр орж ирсэн бичлэг — (хэрэглэгч, багш) хос бүрт нэг мөр.
/// Дахин орвол `lastSeenAt` шинэчлэгдэнэ; худалдан авалтын мөчид `now − lastSeenAt ≤ referralWindowDays` бол REFERRAL.
model ReferralAttribution {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid
  firstSeenAt DateTime @map("first_seen_at")
  lastSeenAt  DateTime @map("last_seen_at")

  user    User @relation("ReferralLearner", fields: [userId], references: [id], onDelete: Cascade)
  teacher User @relation("ReferralTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([userId, teacherId])
  @@index([teacherId, lastSeenAt(sort: Desc)])
  @@map("referral_attributions")
}

// ---------------------------------------------------------------------------
// Суралцах үйл явц (ticket 12): lesson-ы явц, quiz оролдлого
// ---------------------------------------------------------------------------

/// Хэрэглэгч × lesson-ы явц. Утгууд зөвхөн өсөнө (watchedPercent, bestScorePercent max; completedAt нэг удаа).
model LessonProgress {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  courseId         String    @map("course_id") @db.Uuid
  /// VIDEO: хамгийн их үзсэн хувь (0–100); ≥ 90 → дууссан
  watchedPercent   Int       @default(0) @map("watched_percent")
  /// QUIZ: хамгийн өндөр оноо (0–100 %)
  bestScorePercent Int?      @map("best_score_percent")
  completedAt      DateTime? @map("completed_at")
  lastViewedAt     DateTime  @default(now()) @map("last_viewed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@index([lessonId])
  @@index([courseId])
  @@map("lesson_progress")
}

/// Quiz-ийн оролдлого бүр (append-only). Хариулт + тухайн үеийн оноо хадгалагдана.
model QuizAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  lessonId      String   @map("lesson_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  /// [{ questionId, optionIds }]
  answers       Json
  correctCount  Int      @map("correct_count")
  questionCount Int      @map("question_count")
  scorePercent  Int      @map("score_percent")
  /// Тухайн үеийн тэнцэх оноо
  passPercent   Int      @map("pass_percent")
  passed        Boolean
  createdAt     DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([userId, lessonId, createdAt(sort: Desc)])
  @@index([lessonId])
  @@index([courseId])
  @@map("quiz_attempts")
}

/// Даалгаврын илгээлт (ticket 13). Илгээлт бүр тусдаа мөр (дахин илгээхэд шинэ мөр, хуучин нь түүх);
/// (суралцагч, lesson) бүрт `attempt` 1, 2, … — unique тул зэрэг илгээлт давхардахгүй. `is_latest` = одоогийн
/// илгээлт (багшийн inbox). Үнэлгээ тухайн илгээлтэд. Файл storage `private` bucket-д (`file_key`).
/// Даалгаврын тайлбар, хамгийн их оноо `lessons.content`-д. Quiz-ийн оноо, сертификатаас тусдаа.
model AssignmentSubmission {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  lessonId        String    @map("lesson_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  attempt         Int
  isLatest        Boolean   @default(true) @map("is_latest")
  text            String?
  fileKey         String?   @map("file_key")
  fileName        String?   @map("file_name")
  fileSize        Int?      @map("file_size")
  fileContentType String?   @map("file_content_type")
  /// Үнэлгээ (null = шалгагдаагүй). `max_score` — үнэлэх үеийн хамгийн их оноо.
  score           Int?
  maxScore        Int?      @map("max_score")
  comment         String?
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  user       User   @relation("SubmissionLearner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?  @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId, attempt])
  @@index([courseId, isLatest, reviewedAt])
  @@index([lessonId])
  @@map("assignment_submissions")
}

// ---------------------------------------------------------------------------
// Сертификат (ticket 15)
// ---------------------------------------------------------------------------

/// Курс дүүргэсний сертификат — хэрэглэгч × курс тутамд нэг, олгогдсоны дараа ӨӨРЧЛӨГДӨХГҮЙ.
/// Нэр, курс, багшийн нэрийг олгох мөчийнхөөр хадгална (дараа нь profile/курс өөрчлөгдсөн ч PDF, verify ижил).
/// PDF-ийг эдгээр талбараас тухай бүр үүсгэнэ (apps/api/src/learning/certificate-pdf.ts).
model Certificate {
  id                 String   @id @default(uuid()) @db.Uuid
  /// Нийтийн verify код (`/verify/<code>`): 16 тэмдэгт, crypto random (80 бит)
  code               String   @unique
  userId             String   @map("user_id") @db.Uuid
  courseId           String   @map("course_id") @db.Uuid
  recipientName      String   @map("recipient_name")
  courseTitle        String   @map("course_title")
  teacherName        String   @map("teacher_name")
  /// Quiz-уудын хамгийн өндөр онооны дундаж (floor); quiz-гүй курст null
  quizAveragePercent Int?     @map("quiz_average_percent")
  /// Нөхцөлд тооцогдсон lesson-ы тоо
  lessonCount        Int      @map("lesson_count")
  issuedAt           DateTime @default(now()) @map("issued_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Payout (ticket 20)
// ---------------------------------------------------------------------------

enum PayoutStatus {
  /// Багш хүссэн, админ шилжүүлэхийг хүлээж буй (дүн түгжигдсэн)
  REQUESTED
  /// Админ гараар шилжүүлж "төлсөн" гэж тэмдэглэсэн — ledger-т PAYOUT бичилттэй
  PAID
  /// Админ татгалзсан — дүн үлдэгдэлд буцна (ledger-т бичилтгүй)
  REJECTED
}

/// Багшийн payout хүсэлт. Багш бүрт нэг л нээлттэй (REQUESTED) хүсэлт (partial unique index).
/// Хүсэлтийн дүн = тухайн үеийн бүтэн үлдэгдэл; нээлттэй байх хугацаанд түгжигдэнэ.
model Payout {
  id             String       @id @default(uuid()) @db.Uuid
  teacherId      String       @map("teacher_id") @db.Uuid
  status         PayoutStatus @default(REQUESTED)
  amountMnt      Int          @map("amount_mnt")
  /// Хүсэлт гаргах үеийн банкны дансны хуулбар — дараа данс өөрчлөгдсөн ч энэ хүсэлтийн мөнгө хаашаа явахыг тогтооно
  bank           String
  accountNumber  String       @map("account_number")
  holderName     String       @map("holder_name")
  requestedAt    DateTime     @default(now()) @map("requested_at")
  /// PAID / REJECTED болсон үе, хийсэн админ
  processedAt    DateTime?    @map("processed_at")
  processedById  String?      @map("processed_by_id") @db.Uuid
  /// Банкны гүйлгээний утга / дугаар (сонголтоор)
  transferRef    String?      @map("transfer_ref")
  rejectReason   String?      @map("reject_reason")
  /// PAID: ledger-ийн PAYOUT бичилт
  earningEntryId String?      @unique @map("earning_entry_id") @db.Uuid

  teacher      User                 @relation("PayoutTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  processedBy  User?                @relation("PayoutProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  earningEntry TeacherEarningEntry? @relation(fields: [earningEntryId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([teacherId, requestedAt(sort: Desc), id(sort: Desc)])
  @@map("payouts")
}

/// Админы payout hold: мөр байвал багш хүсэлт гаргахгүй, нээлттэй хүсэлтийг "төлсөн" болгохгүй.
model PayoutHold {
  teacherId   String   @id @map("teacher_id") @db.Uuid
  reason      String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  teacher   User  @relation("PayoutHoldTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PayoutHoldActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("payout_holds")
}

/// Курсийн үнэлгээ (ticket 18): курсийн нийтлэгдсэн lesson-уудын ≥ `reviewMinOwnedPercent`%-ийг эзэмшсэн
/// хэрэглэгч курс бүрт НЭГ үнэлгээ (засаж болно). Нуусан (`hidden_at`) үнэлгээ нийтэд болон дундажид орохгүй.
model Review {
  id           String    @id @default(uuid()) @db.Uuid
  courseId     String    @map("course_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// 1–5 (DB CHECK)
  rating       Int
  /// Сэтгэгдэл (хоосон байж болно — зөвхөн од)
  body         String    @default("")
  /// Зохиогч сүүлд зассан үе (засаагүй бол null)
  editedAt     DateTime? @map("edited_at")
  /// Админ нуусан үе, админ, шалтгаан
  hiddenAt     DateTime? @map("hidden_at")
  hiddenById   String?   @map("hidden_by_id") @db.Uuid
  hiddenReason String?   @map("hidden_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User          @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  hiddenBy User?         @relation("ReviewHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  replies  ReviewReply[]

  @@unique([userId, courseId])
  @@index([courseId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("reviews")
}

/// Үнэлгээний thread хариулт — курсийн багш болон үнэлгээний зохиогч (хязгааргүй).
model ReviewReply {
  id           String    @id @default(uuid()) @db.Uuid
  reviewId     String    @map("review_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  body         String
  hiddenAt     DateTime? @map("hidden_at")
  hiddenById   String?   @map("hidden_by_id") @db.Uuid
  hiddenReason String?   @map("hidden_reason")
  createdAt    DateTime  @default(now()) @map("created_at")

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author   User   @relation("ReviewReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  hiddenBy User?  @relation("ReviewReplyHider", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt, id])
  @@map("review_replies")
}
