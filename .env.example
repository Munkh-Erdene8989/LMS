# Энэ файлыг `.env` нэрээр хуулж, утгуудыг бөглөнө. `.env` git-д орохгүй.
# Supabase → Project → Connect товч → connection string-үүд.

# --- Өгөгдлийн сан (Supabase lms-dev төсөл) ---
# Transaction pooler (port 6543). Апп ажиллах үед.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (port 5432). Migration-д.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Тест: Session pooler + тусдаа schema. Тест энэ schema-ийн өгөгдлийг устгадаг тул `public` БИШ байх ёстой.
DATABASE_URL_TEST="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=lms_test"

# --- API (apps/api) ---
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Browser API-г web-ийн /api proxy-оор дууддаг тул refresh cookie Path=/api/auth
COOKIE_PATH_PREFIX="/api"
# API-ийн өмнөх proxy hop-ын тоо (rate limit-ийн client IP). Railway: 1
TRUST_PROXY=1

# --- Web (apps/web) ---
API_URL="http://localhost:4000"

# --- Нэвтрэлт (02) ---
# Access token-ий гарын үсэг + OTP hash. Дор хаяж 32 тэмдэгт. Үүсгэх:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# verify.mn (утас баталгаажуулалт, https://verify.mn/#api). Хоосон бол dev-д fake.
VERIFY_MN_API_KEY=""
# Resend (имэйл OTP). Хоосон бол dev-д имэйлийг API-ийн консолд хэвлэнэ.
RESEND_API_KEY=""
# Domain баталгаажуулаагүй бол onboarding@resend.dev зөвхөн Resend аккаунтын имэйл рүү илгээнэ.
EMAIL_FROM="LMS <onboarding@resend.dev>"

# --- Дараалал (03) ---
# Railway Redis. Хоосон бол dev-д process доторх дараалал (cron ажиллахгүй). Production-д заавал.
REDIS_URL=
# Энэ process арын ажлыг гүйцэтгэх эсэх
WORKERS_ENABLED=true
# Имэйл дэх линкүүдийн суурь хаяг
PUBLIC_WEB_URL="http://localhost:3000"

# --- Файл хадгалалт (06) ---
# Supabase → Project Settings → API. Хоосон бол dev-д local диск (apps/api/.storage). Production-д заавал.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Дараагийн ticket-үүдэд нэмэгдэнэ ---
# QPAY_CLIENT_ID=           (08 Кредит)
# QPAY_CLIENT_SECRET=       (08 Кредит)
# MUX_TOKEN_ID=             (10 Видео)
# MUX_TOKEN_SECRET=         (10 Видео)
# SENTRY_DSN=               (23 Production)
